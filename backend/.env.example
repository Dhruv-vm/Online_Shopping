# ==============================================================================
# BASKET Backend Environment Variables (Example Template)
# Copy this file to .env and configure with your actual environment values.
# NEVER commit the real .env file or credentials to source control.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="BASKET Backend"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Aiven PostgreSQL Database (System of Record)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>?ssl=<require|disable>
# If left empty, local app starts in development mode; /ready indicates DB unconfigured.
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_SSL_MODE=require

# Aiven Apache Kafka (Domain Events & Outbox)
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_SSL_CA_LOCATION=
KAFKA_SSL_CERTIFICATE_LOCATION=
KAFKA_SSL_KEY_LOCATION=

# Aiven OpenSearch (Derived Search Index)
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_PREFIX=basket
