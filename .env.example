# ==============================================================================
# BASKET Platform — Unified Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this template to `.env` in the repository root or backend directory.
# 2. Replace all placeholder values (<placeholder>) with authentic sandbox credentials.
# 3. NEVER commit real credentials, private keys, or certificates to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=sandbox
DEBUG=false
PROJECT_NAME="BASKET Universal Storefront"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret for JWT signing and session integrity
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Internal service key for background workers, reconciliation, and SLA escalation (min 32 chars)
INTERNAL_SERVICE_KEY=replace_with_internal_worker_service_key_min_32_chars

# ------------------------------------------------------------------------------
# 3. Aiven PostgreSQL Database (System of Record)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>?ssl=<require|disable>
DATABASE_URL=postgresql+asyncpg://avnadmin:<password>@<pg-host>.aivencloud.com:28000/defaultdb?ssl=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_SSL_MODE=require

# ------------------------------------------------------------------------------
# 4. Aiven Apache Kafka (KRaft Event Streaming & Outbox)
# ------------------------------------------------------------------------------
# Comma-separated list of broker endpoints
KAFKA_BOOTSTRAP_SERVERS=<kafka-host>.aivencloud.com:28002
KAFKA_SECURITY_PROTOCOL=SSL

# Relative or absolute paths to mutual TLS certificate files from Aiven console
KAFKA_SSL_CA_LOCATION=infra/aiven/certs/ca.pem
KAFKA_SSL_CERTIFICATE_LOCATION=infra/aiven/certs/service.cert
KAFKA_SSL_KEY_LOCATION=infra/aiven/certs/service.key

# ------------------------------------------------------------------------------
# 5. Aiven OpenSearch (Derived Catalogue Search Index)
# ------------------------------------------------------------------------------
# Full HTTPS URL to Aiven OpenSearch service
OPENSEARCH_URL=https://<opensearch-host>.aivencloud.com:28004
OPENSEARCH_USERNAME=avnadmin
OPENSEARCH_PASSWORD=<aiven_opensearch_password>
OPENSEARCH_INDEX_PREFIX=basket
OPENSEARCH_VERIFY_CERTS=true

# ------------------------------------------------------------------------------
# 6. Razorpay Payment Gateway (Sandbox API Integration)
# ------------------------------------------------------------------------------
# Razorpay TEST key pair from Dashboard -> Settings -> API Keys (Format: rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_replace_with_your_sandbox_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_secret_key_min_16_chars
RAZORPAY_WEBHOOK_SECRET=replace_with_your_webhook_signing_secret_min_16_chars
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_CONNECT_TIMEOUT_SECONDS=5.0
RAZORPAY_READ_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 7. Frontend Storefront (Next.js 15) Environment Variables
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=sandbox
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_with_your_sandbox_key_id
