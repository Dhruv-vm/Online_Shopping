# ==============================================================================
# BASKET Infrastructure Configuration (Aiven Service Details)
# Replace placeholders with service URI/connection properties from Aiven Console.
# ==============================================================================

# Aiven PostgreSQL
AIVEN_PG_HOST=pg-xxxx-yyyy.aivencloud.com
AIVEN_PG_PORT=28000
AIVEN_PG_USER=avnadmin
AIVEN_PG_PASSWORD=replace-with-aiven-pg-password
AIVEN_PG_DATABASE=defaultdb
AIVEN_PG_SSL_MODE=require

# Aiven Apache Kafka
AIVEN_KAFKA_HOST=kafka-xxxx-yyyy.aivencloud.com
AIVEN_KAFKA_PORT=28002
AIVEN_KAFKA_SECURITY_PROTOCOL=SSL
AIVEN_KAFKA_CA_CERT_PATH=infra/aiven/certs/ca.pem
AIVEN_KAFKA_ACCESS_CERT_PATH=infra/aiven/certs/service.cert
AIVEN_KAFKA_ACCESS_KEY_PATH=infra/aiven/certs/service.key

# Aiven OpenSearch
AIVEN_OPENSEARCH_HOST=opensearch-xxxx-yyyy.aivencloud.com
AIVEN_OPENSEARCH_PORT=28004
AIVEN_OPENSEARCH_USER=avnadmin
AIVEN_OPENSEARCH_PASSWORD=replace-with-aiven-opensearch-password
